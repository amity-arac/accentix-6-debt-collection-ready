   "company": "LIB",
   "intent_name": "date_too_far"
  },
  {
   "text_id": 7030,
   "_fine_state": "close_confirmed",
   "state": "closing",
   "template": "Thank you. The library has noted that it will be returned on [due_date]. Goodbye.",
   "company": "LIB",
   "intent_name": "close_confirmed"
  },
  {
   "text_id": 7031,
   "_fine_state": "close_extended",
   "state": "closing",
   "template": "Thank you. It is renewed to [new_due_date]. Goodbye.",
   "company": "LIB",
   "intent_name": "close_extended"
  },
  {
   "text_id": 7032,
   "_fine_state": "close_returned",
