  },
  {
   "text_id": 7061,
   "_fine_state": "faq_due",
   "state": "faq",
   "template": "It is due back on [due_date].",
   "hint": "The normal answer - for a full question that does not ask for more detail"
  },
  {
   "text_id": 7062,
   "_fine_state": "faq_due",
   "state": "faq",
   "template": "[book_title] is due back on [due_date]. If it is overdue there is a fine of [fine_per_day] baht a day.",
   "hint": "The detailed answer - for a customer who asks for detail, asks several things at once, or asks about the fine too"
  }
 ]
}