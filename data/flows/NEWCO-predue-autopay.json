    "ไม่อยากผูกบัญชี",
    "ไว้ก่อน"
   ]
  }
 },
 "tools": {
  "require_kyc": false,
  "notes": [
   "ไม่มี KYC ถามเลข 4 หลัก และไม่มีการโอนสายไปเจ้าหน้าที่จริง (ตามบอทจริง)"
  ],
  "declarations": [
   {
    "name": "check_account_status",
    "impl": "check_account_status",
    "desc": "อ่านข้อมูลบัญชี (ยอด/วันครบกำหนด/สถานะ)",
    "args": {},
    "gating": {
     "after_event": "name_confirmed",
     "required_before_state": "remind",
     "max_calls_per_conversation": 1
    }
   },
   {
    "name": "record_verbal_commitment",
    "impl": "record_verbal_commitment",
    "desc": "บันทึกคำมั่นด้วยวาจา (amount, date, channel)",
    "args": {
     "amount": {
      "type": "string"
     },
     "date": {
      "type": "string",
      "format": "YYYY-MM-DD (Weekday)"
     },
     "channel": {
      "type": "string",
      "enum": [
       "atm",
       "bank_transfer",
       "branch",
       "counter_service",
       "mobile_app",
       "other"
      ]
     }
    },
    "gating": {
     "must_precede": "payment_date"
    }
   },
   {
    "name": "payment_date",
    "impl": "payment_date",
    "desc": "บันทึกนัดชำระลง CRM",
    "args": {
     "last_4_digits": {
      "type": "string",
      "optional": true
     },
     "amount": {
      "type": "number"
     },
     "date": {
      "type": "string",
      "format": "YYYY-MM-DD (Weekday)"
     },
     "channel": {
      "type": "string",
      "enum": [
       "atm",
       "bank_transfer",
       "branch",
       "counter_service",
       "mobile_app",
       "other"
      ]
     }
    },
    "gating": {
     "requires_prior": "record_verbal_commitment",
     "args_must_match_commitment": true
    }
   },
   {
    "name": "callback_datetime",
    "impl": "callback_datetime",
    "desc": "บันทึกนัดโทรกลับ",
    "args": {
     "date": {
      "type": "string",
      "format": "YYYY-MM-DD (Weekday)"
     }
    }
   },
   {
    "name": "get_current_datetime",
    "impl": "get_current_datetime",
    "desc": "ขอวันที่มาตรฐาน",
    "args": {},
    "gating": {
     "required_before": "non_today_date_in_args_or_reply"
    }
   },
   {
    "name": "record_outcome",
    "impl": "record_outcome",
    "desc": "บันทึกผลสาย (result, reason, remark)",
    "args": {
     "result": {
      "type": "string",
      "enum": [
       "ptp",
       "refused",
       "unreachable",
       "reached",
       "tcb",
       "tin"
      ]
     },
     "reason": {
      "type": "string",
      "optional": true
     },
     "remark": {
      "type": "string",
      "optional": true
     }
    },
    "gating": {
     "required_at": "end_of_call",
     "max_successful_calls": 1
    }
   },
   {
    "name": "update_phone",
    "impl": "update_phone",
    "desc": "บันทึกเบอร์ติดต่อใหม่",
    "args": {
     "number": {
      "type": "string"
     }
    }
   }
  ],
  "validation": {
   "date_format": "YYYY-MM-DD (Weekday)",
   "payment_channels": [
    "atm",
    "bank_transfer",
    "branch",
    "counter_service",
    "mobile_app",
    "other"
   ],
   "case_status_gates": {
    "pending_review": "account_under_review",
    "closed": "account_closed"
   },
   "result_codes": [
    "ptp",
    "refused",
    "unreachable",
    "reached",
    "tcb",
    "tin"
   ]
  }
 },
 "states": [
  {
   "id": "greet",
   "phase": "opening",
   "templates": [
    {
     "fine_state": "greet_verify"
    }
   ],
   "initial": true,
   "on": [
    {
     "event": "name_confirmed",
     "to": "remind"
    },
    {
     "event": "no_input",
     "to": "verify_retry"
    },
    {
     "event": "third_party",
     "to": "third_party"
    }
   ]
  },
  {
   "id": "verify_retry",
   "phase": "opening",
   "templates": [
    {
     "fine_state": "verify_name"
    }
   ],
   "on": [
    {
     "event": "name_confirmed",
     "to": "remind"
    },
    {
     "event": "third_party",
     "to": "third_party"
    },
    {
     "event": "no_input",
     "to": "close_unreachable"
    }
   ]
  },
  {
   "id": "third_party",
   "phase": "opening",
   "templates": [
    {
     "fine_state": "third_party"
    }
   ],
   "on": [
    {
     "event": "gives_new_phone",
     "to": "close_unreachable"
    },
    {
     "event": "no_input",
     "to": "close_unreachable"
    },
    {
     "event": "refuses",
     "to": "close_unreachable"
    }
   ]
  },
  {
   "id": "remind",
   "phase": "main",
   "templates": [
    {
     "fine_state": "courtesy_remind"
    },
    {
     "fine_state": "ask_autopay"
    }
   ],
   "note": "แจ้งเตือนล่วงหน้า (ยังไม่ครบกำหนด) แล้วเสนอสมัครหักบัญชีอัตโนมัติ",
   "on": [
    {
     "event": "agrees_autopay",
     "to": "enroll_autopay"
    },
    {
     "event": "already_autopay",
     "to": "close_already"
    },
    {
     "event": "will_pay_manually",
     "to": "manual_ptp"
    },
    {
     "event": "declines_autopay",
     "to": "offer_reminder"
    },
    {
     "event": "reschedule_request",
     "to": "callback_close"
    },
    {
     "event": "stop_signal",
     "to": "close_optout"
    },
    {
     "event": "no_input",
     "to": "close_confirm_info"
    }
   ]
  },
  {
   "id": "offer_reminder",
   "phase": "main",
   "templates": [
    {
     "fine_state": "remind_due_date"
    },
    {
     "fine_state": "ask_confirm_pay"
    }
   ],
   "note": "ลูกค้าไม่เอา autopay → ย้ำวันครบกำหนด + ยืนยันว่าจะชำระเอง",
   "on": [
    {
     "event": "will_pay_manually",
     "to": "manual_ptp"
    },
    {
     "event": "agrees_autopay",
     "to": "enroll_autopay"
    },
    {
     "event": "stop_signal",
     "to": "close_optout"
    },
    {
     "event": "no_input",
     "to": "close_confirm_info"
    }
   ]
  },
  {
   "id": "enroll_autopay",
   "phase": "close",
   "templates": [
    {
     "fine_state": "confirm_autopay"
    },
    {
     "fine_state": "close"
    }
   ],
   "terminal": true,
   "entry_tools": [
    "record_verbal_commitment",
    "payment_date"
   ],
   "on": [],
   "outcome": {
    "result": "ptp",
    "reasons": [
     "autopay"
    ]
   }
  },
  {
   "id": "manual_ptp",
   "phase": "close",
   "templates": [
    {
     "fine_state": "confirm_info"
    },
    {
     "fine_state": "close"
    }
   ],
   "terminal": true,
   "entry_tools": [
    "record_verbal_commitment",
    "payment_date"
   ],
   "on": [],
   "outcome": {
    "result": "ptp",
    "reasons": [
     "manual"
    ]
   }
  },
  {
   "id": "close_already",
   "phase": "close",
   "templates": [
    {
     "fine_state": "close"
    }
   ],
   "terminal": true,
   "on": [],
   "outcome": {
    "result": "ptp",
    "reasons": [
     "autopay_active"
    ]
   }
  },
  {
   "id": "callback_close",
   "phase": "close",
   "templates": [
    {
     "fine_state": "offer_callback"
    }
   ],
   "terminal": true,
   "entry_tools": [
    "callback_datetime"
   ],
   "on": [],
   "outcome": {
    "result": "tcb",
    "reasons": [
     "callback"
    ]
   }
  },
  {
   "id": "close_optout",
   "phase": "close",
   "templates": [
    {
     "fine_state": "close"
    }
   ],
   "terminal": true,
   "on": [],
   "outcome": {
    "result": "refused",
    "reasons": [
     "dnc"
    ]
   }
  },
  {
   "id": "close_unreachable",
   "phase": "close",
   "templates": [
    {
     "fine_state": "close"
    },
    {
     "fine_state": "apology"
    }
   ],
   "terminal": true,
   "on": [],
   "outcome": {
    "result": "unreachable",
    "reasons": [
     "other_person",
     "wrong_number",
     "no_input"
    ]
   }
  },
  {
   "id": "close_confirm_info",
   "phase": "close",
   "templates": [
    {
     "fine_state": "confirm_info"
    }
   ],
   "terminal": true,
   "on": [],
   "outcome": {
    "result": "reached",
    "reasons": [
     "no_input"
    ]
   }
  }
 ],
 "faq_routing": {
  "note": "FAQ ระหว่างสาย: ตอบแล้วกลับเข้า flow เดิม (resume) เว้น agent/wrong_name ที่ปิดสาย",
  "routes": [
   {
    "intent": "caller",
    "desc": "โทรมาจากไหน",
    "templates": [
     {
      "fine_state": "faq_caller"
     }
    ],
    "then": "resume"
   },
   {
    "intent": "bot",
    "desc": "เป็นบอท/AI ใช่ไหม",
    "templates": [
     {
      "fine_state": "ai_disclosure"
     }
    ],
    "then": "resume"
   },
   {
    "intent": "repeat",
    "desc": "ขอฟังยอด/วันซ้ำ",
    "templates": [
     {
      "fine_state": "faq_repeat"
     }
    ],
    "then": "resume"
   },
   {
    "intent": "amount",
    "desc": "ถามยอด",
    "templates": [
     {
      "fine_state": "faq_amount"
     }
    ],
    "then": "resume"
   },
   {
    "intent": "due",
    "desc": "ถามวันครบกำหนด",
    "templates": [
     {
      "fine_state": "faq_due"
     }
    ],
    "then": "resume"
   },
   {
    "intent": "autopay_how",
    "desc": "หักอัตโนมัติทำงานยังไง",
    "templates": [
     {
      "fine_state": "faq_autopay_how"
     }
    ],
    "then": "resume"
   },
   {
    "intent": "channel",
    "desc": "ถามช่องทางชำระ",
    "templates": [
     {
      "fine_state": "offer_channel"
     }
    ],
    "then": "resume"
   },
   {
    "intent": "agent",
    "desc": "ขอคุยเจ้าหน้าที่",
    "templates": [
     {
      "fine_state": "faq_handoff"
     }
    ],
    "then": {
     "outcome": {
      "result": "tcb",
      "reasons": [
       "agent"
      ]
     },
     "terminal": true
    }
   },
   {
    "intent": "out_of_scope",
    "desc": "นอกขอบเขต",
    "templates": [
     {
      "fine_state": "other"
     }
    ],
    "then": "resume"
   }
  ]
 },
 "auxiliary_templates": {
  "note": "template ตามบริบท",
  "allowed": [
   {
    "fine_state": "offer_channel",
    "desc": "บอกช่องทางชำระ"
   },
   {
    "fine_state": "faq_autopay_how",
    "desc": "อธิบายวิธีหักอัตโนมัติ"
   },
   {
    "fine_state": "other",
    "desc": "ทั่วไป"
   },
   {
    "fine_state": "apology",
    "desc": "ขออภัยตามบริบท"
   },
   {
    "fine_state": "ai_disclosure",
    "desc": "แจ้งว่าเป็นระบบอัตโนมัติ"
   }
  ]
 },
 "constraints": [
  {
   "id": "remind_once",
   "type": "once_per_call",
   "template_fine_state": "courtesy_remind",
   "enforce": [
    "prompt"
   ],
   "desc": "แจ้งเตือนยอด/วันครบกำหนดครั้งเดียวต่อสาย — ถามซ้ำใช้ faq_repeat"
  },
  {
   "id": "repeat_only_on_no_input",
   "type": "repeat_only_on",
   "event": "no_input",
   "enforce": [
