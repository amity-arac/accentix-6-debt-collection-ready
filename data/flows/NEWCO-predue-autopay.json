   ]
  },
  "declines_autopay": {
   "desc": "ไม่สมัคร autopay แต่ยังคุยต่อ",
   "cues": [
    "ไม่สมัคร",
    "ไม่เอา",
    "ขอจ่ายเอง",
    "ไม่หักดีกว่า",
    "ไม่สะดวกให้หัก",
