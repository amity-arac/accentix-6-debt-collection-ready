 "tools": {
  "require_kyc": false,
  "notes": [
   "ไม่มี KYC ถามเลข 4 หลัก และไม่มีการโอนสายไปเจ้าหน้าที่จริง (ตามบอทจริง)"
  ],
  "declarations": [
   {
    "name": "check_account_status",
    "impl": "check_account_status",
    "desc": "อ่านข้อมูลบัญชี (ยอด/วันครบกำหนด/สถานะ)",
    "args": {},
    "gating": {
     "after_event": "name_confirmed",
     "required_before_state": "hub",
     "max_calls_per_conversation": 1
    }
   },
   {
    "name": "record_verbal_commitment",
    "impl": "record_verbal_commitment",
    "desc": "บันทึกคำมั่นด้วยวาจา (amount, date, channel)",
    "args": {
     "amount": {
      "type": "string"
     },
     "date": {
      "type": "string",
      "format": "YYYY-MM-DD (Weekday)"
     },
     "channel": {
      "type": "string",
      "enum": [
       "atm",
       "bank_transfer",
       "branch",
       "counter_service",
       "mobile_app",
       "other"
      ]
     }
    },
    "gating": {
     "must_precede": "payment_date"
    }
   },
   {
    "name": "payment_date",
    "impl": "payment_date",
    "desc": "บันทึกนัดชำระลง CRM",
    "args": {
     "last_4_digits": {
      "type": "string",
      "optional": true
     },
     "amount": {
      "type": "number"
     },
     "date": {
      "type": "string",
      "format": "YYYY-MM-DD (Weekday)"
     },
     "channel": {
      "type": "string",
      "enum": [
       "atm",
       "bank_transfer",
       "branch",
       "counter_service",
       "mobile_app",
       "other"
      ]
     }
    },
    "gating": {
     "requires_prior": "record_verbal_commitment",
     "args_must_match_commitment": true
    }
   },
   {
    "name": "callback_datetime",
    "impl": "callback_datetime",
    "desc": "บันทึกนัดโทรกลับ",
    "args": {
     "date": {
      "type": "string",
      "format": "YYYY-MM-DD (Weekday)"
     }
    }
   },
   {
    "name": "get_current_datetime",
    "impl": "get_current_datetime",
    "desc": "ขอวันที่มาตรฐาน",
    "args": {},
    "gating": {
     "required_before": "non_today_date_in_args_or_reply"
    }
   },
   {
    "name": "record_outcome",
    "impl": "record_outcome",
    "desc": "บันทึกผลสาย (result, reason, remark)",
    "args": {
     "result": {
      "type": "string",
      "enum": [
       "ptp",
       "refused",
       "unreachable",
       "reached",
       "tcb",
       "tin"
      ]
     },
     "reason": {
      "type": "string",
      "optional": true
     },
     "remark": {
      "type": "string",
      "optional": true
     }
    },
    "gating": {
     "required_at": "end_of_call",
     "max_successful_calls": 1
    }
   },
   {
    "name": "update_phone",
    "impl": "update_phone",
    "desc": "บันทึกเบอร์ติดต่อใหม่",
    "args": {
     "number": {
      "type": "string"
     }
    }
   }
  ],
  "validation": {
   "date_format": "YYYY-MM-DD (Weekday)",
   "payment_channels": [
    "atm",
    "bank_transfer",
    "branch",
    "counter_service",
    "mobile_app",
    "other"
   ],
   "case_status_gates": {
    "pending_review": "account_under_review",
    "closed": "account_closed"
   },
   "result_codes": [
    "ptp",
    "refused",
    "unreachable",
    "reached",
    "tcb",
    "tin"
   ]
  }
 },
 "states": [
  {
   "id": "greet_inbound",
   "phase": "opening",
   "templates": [
    {
     "fine_state": "greet_inbound"
    }
   ],
   "initial": true,
   "note": "รับสายเข้า + ยืนยันตัวตนก่อนเปิดเผยข้อมูลบัญชี",
   "on": [
    {
     "event": "name_confirmed",
     "to": "hub"
    },
    {
     "event": "stop_signal",
     "to": "close_optout"
    },
    {
     "event": "no_input",
     "to": "close_confirm_info"
    }
   ]
  },
  {
   "id": "hub",
   "phase": "main",
   "templates": [
    {
     "fine_state": "ask_help"
    }
   ],
   "entry_tools": [
    "check_account_status"
   ],
   "note": "ศูนย์กลาง (hub) — ถามว่าให้ช่วยเรื่องใด แล้วแตกไป spoke; กลับมาที่นี่หลังจบแต่ละเรื่อง",
   "on": [
    {
     "event": "wants_pay",
     "to": "take_payment"
    },
    {
     "event": "asks_balance",
     "to": "balance_info"
    },
    {
     "event": "wants_installment",
     "to": "installment"
    },
    {
     "event": "reports_hardship",
     "to": "hardship_help"
    },
    {
     "event": "wants_agent",
     "to": "handoff"
    },
    {
     "event": "done_no",
     "to": "close_thanks"
    },
    {
     "event": "stop_signal",
     "to": "close_optout"
    },
    {
     "event": "no_input",
     "to": "close_confirm_info"
    }
   ]
  },
  {
   "id": "take_payment",
   "phase": "main",
   "templates": [
    {
     "fine_state": "ask_pay_detail"
    }
   ],
   "note": "spoke: รับชำระ",
   "on": [
    {
     "event": "agrees_to_pay",
     "to": "ptp_capture"
    },
    {
     "event": "ack",
     "to": "hub"
    },
    {
     "event": "reschedule_request",
     "to": "callback_close"
    },
    {
     "event": "no_input",
     "to": "close_confirm_info"
    }
   ]
  },
  {
   "id": "balance_info",
   "phase": "main",
   "templates": [
    {
     "fine_state": "disclose_balance_inbound"
    }
   ],
   "note": "spoke: แจ้งยอด แล้วกลับ hub",
   "on": [
    {
     "event": "ack",
     "to": "hub"
    },
    {
     "event": "agrees_to_pay",
     "to": "ptp_capture"
    },
    {
     "event": "wants_installment",
     "to": "installment"
    },
    {
     "event": "no_input",
     "to": "close_confirm_info"
    }
   ]
  },
  {
   "id": "installment",
   "phase": "main",
   "templates": [
    {
     "fine_state": "offer_installment"
    }
   ],
   "note": "spoke: เสนอผ่อนชำระ",
   "on": [
    {
     "event": "agrees_to_pay",
     "to": "ptp_capture"
    },
    {
     "event": "refuses",
     "to": "hub"
    },
    {
     "event": "wants_agent",
     "to": "handoff"
    },
    {
     "event": "no_input",
     "to": "close_confirm_info"
    }
   ]
  },
  {
   "id": "hardship_help",
   "phase": "main",
   "templates": [
    {
     "fine_state": "ack_hardship"
    },
    {
     "fine_state": "offer_options"
    }
   ],
   "note": "spoke: ช่วยเหลือกรณีจ่ายลำบาก",
   "on": [
    {
     "event": "agrees_to_pay",
     "to": "ptp_capture"
    },
    {
     "event": "wants_installment",
     "to": "installment"
    },
    {
     "event": "reschedule_request",
     "to": "callback_close"
    },
    {
     "event": "refuses",
     "to": "hub"
    },
    {
     "event": "no_input",
     "to": "close_confirm_info"
    }
   ]
  },
  {
   "id": "ptp_capture",
   "phase": "close",
   "templates": [
    {
     "fine_state": "confirm_info"
    },
    {
     "fine_state": "close_thanks"
    }
   ],
   "terminal": true,
   "entry_tools": [
    "record_verbal_commitment",
    "payment_date"
   ],
   "on": [],
   "outcome": {
    "result": "ptp",
    "reasons": [
     "ptp",
     "minimum"
    ]
   }
  },
  {
   "id": "handoff",
   "phase": "close",
   "templates": [
    {
     "fine_state": "handoff_line"
    }
   ],
   "terminal": true,
   "on": [],
   "outcome": {
    "result": "tcb",
    "reasons": [
     "agent"
    ]
   }
  },
  {
   "id": "callback_close",
   "phase": "close",
   "templates": [
    {
     "fine_state": "offer_callback"
    }
   ],
   "terminal": true,
   "entry_tools": [
    "callback_datetime"
   ],
   "on": [],
   "outcome": {
    "result": "tcb",
    "reasons": [
     "callback"
    ]
   }
  },
  {
   "id": "close_thanks",
   "phase": "close",
   "templates": [
    {
     "fine_state": "close_thanks"
    }
   ],
   "terminal": true,
   "on": [],
   "outcome": {
    "result": "reached",
    "reasons": [
     "done"
    ]
   }
  },
  {
   "id": "close_confirm_info",
   "phase": "close",
   "templates": [
    {
     "fine_state": "confirm_info"
    }
   ],
   "terminal": true,
   "on": [],
   "outcome": {
    "result": "reached",
    "reasons": [
     "no_input"
    ]
   }
  },
  {
   "id": "close_optout",
   "phase": "close",
   "templates": [
    {
     "fine_state": "close_thanks"
    }
   ],
   "terminal": true,
   "on": [],
   "outcome": {
    "result": "refused",
    "reasons": [
     "dnc"
    ]
   }
  }
 ],
 "faq_routing": {
  "note": "FAQ ระหว่างสาย: ตอบแล้ว resume; agent → ปิดโอนคน",
  "routes": [
   {
    "intent": "caller",
    "desc": "ที่นี่ที่ไหน",
    "templates": [
     {
      "fine_state": "faq_caller"
     }
    ],
    "then": "resume"
   },
   {
    "intent": "bot",
    "desc": "เป็นบอทไหม",
    "templates": [
     {
      "fine_state": "ai_disclosure"
     }
    ],
    "then": "resume"
   },
   {
    "intent": "amount",
    "desc": "ถามยอด",
    "templates": [
     {
      "fine_state": "faq_amount"
     }
    ],
    "then": "resume"
   },
   {
    "intent": "channel",
    "desc": "ช่องทางชำระ",
    "templates": [
     {
      "fine_state": "offer_channel"
     }
    ],
    "then": "resume"
   },
   {
    "intent": "agent",
    "desc": "ขอเจ้าหน้าที่",
    "templates": [
     {
      "fine_state": "handoff_line"
     }
    ],
    "then": {
     "outcome": {
      "result": "tcb",
      "reasons": [
       "agent"
      ]
     },
     "terminal": true
    }
   },
   {
    "intent": "out_of_scope",
    "desc": "นอกขอบเขต",
    "templates": [
     {
      "fine_state": "other"
     }
    ],
    "then": "resume"
   }
  ]
 },
 "auxiliary_templates": {
  "note": "template ตามบริบท",
  "allowed": [
   {
    "fine_state": "offer_channel",
    "desc": "ช่องทางชำระ"
   },
   {
    "fine_state": "other",
    "desc": "ทั่วไป"
   },
   {
    "fine_state": "apology",
    "desc": "ขออภัย"
   },
   {
    "fine_state": "ai_disclosure",
    "desc": "แจ้งว่าเป็นระบบอัตโนมัติ"
   }
  ]
 },
 "constraints": [
  {
   "id": "repeat_only_on_no_input",
   "type": "repeat_only_on",
   "event": "no_input",
   "enforce": [
    "prompt"
   ],
   "desc": "พูดซ้ำได้เฉพาะตอนลูกค้าเงียบ"
  }
 ],
 "outcomes": {
  "required_at_close": true,
  "results": {
   "ptp": {
    "reasons": [
     "ptp",
     "minimum"
    ],
    "desc": "รับปากชำระ/ตกลงผ่อน"
   },
   "tcb": {
    "reasons": [
     "agent",
     "callback"
    ],
