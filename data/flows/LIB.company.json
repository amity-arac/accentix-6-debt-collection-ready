 "crm_fields": [
  "today",
  "customer_name",
  "book_title",
  "due_date",
  "fine_per_day",
  "library_phone"
 ],
 "crm_labels": {
  "book_title": "ชื่อหนังสือ",
  "fine_per_day": "ค่าปรับต่อวัน"
 },
 "session_init": {
  "url": "{API_BASE}/LIB/init?msisdn={msisdn}",
  "method": "GET",
  "timeout": 8,
  "on_failure": {
   "fine_state": "close_handoff",
   "outcome": {
    "args": {
     "result": "handoff",
     "reason": "ระบบไม่ตอบ ให้เจ้าหน้าที่ติดต่อกลับ"
    }
   }
  }
 },
 "tools": {
  "declarations": [
   {
    "name": "check_extend",
    "impl": "http",
    "url": "{API_BASE}/LIB/check_extend",
    "method": "POST",
    "desc": "ตรวจว่าต่ออายุถึงวันที่ลูกค้าขอได้ไหม — ห้ามตัดสินเอง",
    "args": {
     "date": {
      "type": "string",
      "format": "YYYY-MM-DD (Weekday)",
      "desc": "วันที่ลูกค้าบอก แปลงเป็น canonical ก่อนส่ง"
     }
    },
    "returns": {
     "in_range": {
      "type": "boolean",
      "desc": "ต่อได้ไหม"
     },
     "valid_dates": {
      "type": "array",
      "desc": "วันที่ต่อได้ (canonical)"
     },
     "max_extend_days": {
      "type": "number",
      "desc": "ต่อได้ไม่เกินกี่วัน"
     },
     "new_due_date": {
      "type": "string",
      "desc": "วันครบกำหนดใหม่ที่ผ่านการตรวจ"
     }
    },
    "gating": {
     "after_event": "gives_date",
     "note": "เรียกเมื่อลูกค้าระบุวันแล้วเท่านั้น การนับวันเป็นหน้าที่ของระบบ"
    },
    "mock": {
     "rules": [
      {
       "when": {
        "arg": "date",
        "within_days_of": {
         "field": "due_date",
         "days_field": "max_extend_days"
        }
       },
       "body": {
        "in_range": true,
        "max_extend_days": 14,
        "new_due_date": "{{body 'args.date'}}"
       },
       "label": "ต่อได้ (due_date + max_extend_days)"
      }
     ],
     "default": {
      "in_range": false,
      "valid_dates": [],
      "max_extend_days": 14,
      "new_due_date": "",
      "note": "เกินกำหนดที่ต่อได้"
     }
    }
   },
   {
    "name": "record_call_result",
    "impl": "http",
    "url": "{API_BASE}/LIB/record_call_result",
    "method": "POST",
    "desc": "บันทึกผลสาย — เรียกครั้งเดียวก่อนวางสาย",
    "args": {
     "result": {
      "type": "string",
      "desc": "ผลของสายนี้",
      "enum": [
       "confirmed",
       "extended",
       "returned",
       "wrong_person",
       "handoff",
       "unreachable"
      ]
     },
     "new_due_date": {
      "type": "string",
      "optional": true,
      "format": "YYYY-MM-DD (Weekday)",
      "desc": "วันครบกำหนดใหม่ — บังคับเมื่อ result=extended ใช้ค่าที่ check_extend คืนมา",
      "required_when": {
       "arg": "result",
       "equals": "extended"
      },
      "one_of_from": {
       "tool": "check_extend",
       "field": "valid_dates"
      }
     },
     "reason": {
      "type": "string",
      "optional": true,
      "desc": "เหตุผลของผลสายนี้ (ระบบเติมเองเมื่อ session_init ไม่ตอบ)"
     }
    },
    "gating": {
     "required_at": "end_of_call",
     "max_successful_calls": 1
    }
   }
  ]
 },
 "states": [
  {
   "id": "greet",
   "phase": "opening",
   "initial": true,
   "templates": [
    {
     "fine_state": "greet_remind"
    }
   ],
   "on": [
    {
     "event": "confirms_return",
     "to": "close_confirmed"
    },
    {
     "event": "request_extend",
     "to": "ask_new_date"
    },
    {
     "event": "already_returned",
     "to": "close_returned"
    },
    {
     "event": "wrong_person",
     "to": "close_wrong"
    },
    {
     "event": "no_input",
     "to": "close_unreachable"
    }
   ]
  },
  {
   "id": "ask_new_date",
   "phase": "main",
   "templates": [
    {
     "fine_state": "ask_new_date"
    }
   ],
   "on": [
    {
     "event": "gives_date",
     "to": "confirm_extend"
    }
   ]
  },
  {
   "id": "confirm_extend",
   "phase": "main",
   "templates": [
    {
     "any_of": [
      "confirm_new_due",
      "date_too_far"
     ]
    }
   ],
   "entry_tools": [
    "check_extend"
   ],
   "on": [
    {
     "event": "confirms_return",
     "to": "close_extended"
    },
    {
     "event": "gives_date",
     "to": "confirm_extend"
    }
   ]
  },
  {
   "id": "close_confirmed",
   "phase": "close",
   "terminal": true,
   "templates": [
    {
     "fine_state": "close_confirmed"
    }
   ],
   "entry_tools": [
    "record_call_result"
   ],
   "outcome": {
    "args": {
     "result": "confirmed"
    }
   }
  },
  {
   "id": "close_extended",
   "phase": "close",
   "terminal": true,
   "templates": [
    {
     "fine_state": "close_extended"
    }
   ],
   "entry_tools": [
    "record_call_result"
   ],
   "outcome": {
    "args": {
     "result": "extended"
    }
   }
  },
  {
   "id": "close_returned",
   "phase": "close",
   "terminal": true,
   "templates": [
    {
     "fine_state": "close_returned"
    }
   ],
   "entry_tools": [
    "record_call_result"
   ],
   "outcome": {
    "args": {
     "result": "returned"
    }
   }
  },
  {
   "id": "close_wrong",
   "phase": "close",
   "terminal": true,
   "templates": [
    {
     "fine_state": "close_wrong"
    }
   ],
   "entry_tools": [
    "record_call_result"
   ],
   "outcome": {
    "args": {
     "result": "wrong_person"
    }
   }
  },
  {
   "id": "close_unreachable",
   "phase": "close",
   "terminal": true,
   "templates": [
    {
     "fine_state": "close_unreachable"
    }
   ],
   "entry_tools": [
    "record_call_result"
   ],
   "outcome": {
    "args": {
     "result": "unreachable"
    }
   }
  },
  {
   "id": "close_handoff",
   "phase": "close",
   "terminal": true,
   "templates": [
    {
     "fine_state": "close_handoff"
    }
   ],
   "entry_tools": [
    "record_call_result"
   ],
   "outcome": {
    "args": {
     "result": "handoff"
    }
   }
  }
 ],
 "faq_routing": {
  "routes": [
   {
    "intent": "due",
    "templates": [
     {
      "fine_state": "faq_due"
     }
    ],
    "then": "resume"
   },
   {
    "intent": "fine",
    "templates": [
     {
      "fine_state": "faq_fine"
     }
    ],
    "then": "resume"
   },
   {
    "intent": "hours",
    "templates": [
     {
      "fine_state": "faq_hours"
     }
    ],
    "then": "resume"
   }
  ]
 },
 "auxiliary_templates": {
  "allowed": [
   {
    "fine_state": "faq_repeat"
   }
  ]
 },
 "fallback_fine_state": "faq_repeat",
 "constraints": [
  {
   "id": "one_template_per_turn",
   "type": "max_templates_per_reply",
   "max": 1,
   "desc": "พูดหนึ่งจังหวะต่อเทิร์น",
   "enforce": [
    "prompt"
   ]
  },
  {
   "id": "system_counts_days",
   "enforce": [
    "prompt"
   ],
   "desc": "ห้ามนับวันเอง — ลูกค้าบอกวันแล้วต้องเรียก check_extend แล้วอ่าน in_range จากคำตอบ"
  },
  {
   "id": "greeting_once",
   "type": "once_per_call",
   "template_fine_states": [
    "greet_remind"
   ],
   "enforce": [
    "prompt"
   ],
   "desc": "ทักทายแจ้งกำหนดคืนครั้งเดียวต่อสาย"
  },
  {
   "id": "open_with_greeting",
   "enforce": [
    "prompt"
   ],
   "desc": "เปิดสายด้วย greet_remind ก่อนเสมอ — แจ้งชื่อหนังสือและกำหนดคืนจาก CRM snapshot ได้ทันที ไม่ต้องยืนยันตัวตน"
  },
  {
   "id": "no_close_before_answer",
   "enforce": [
    "prompt"
   ],
   "desc": "ห้ามเรียก record_call_result ก่อนที่ลูกค้าจะตอบว่าจะคืนตามกำหนด/ขอต่ออายุ/คืนไปแล้ว — คำรับสาย (ฮัลโหล/สวัสดี/ว่าไงครับ) ไม่นับเป็นคำตอบ ให้ทักทายแจ้งกำหนดคืนก่อน"
  }
 ],
