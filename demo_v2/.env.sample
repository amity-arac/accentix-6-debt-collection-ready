# demo_v2 — ตัวอย่างค่าตั้งต้น
# คัดลอกเป็น demo_v2/.env แล้วแก้ตามเครื่อง  (cp demo_v2/.env.sample demo_v2/.env)
# ทุกตัวมีค่าปริยายในโค้ดอยู่แล้ว — ไม่ตั้งก็รันได้ ยกเว้นสองตัวในหัวข้อ "ต้องตั้ง"

# ══ ต้องตั้ง ═════════════════════════════════════════════════════════
# ปลายทาง vLLM ที่เสิร์ฟโมเดล (OpenAI-compatible)
AAX6_VLLM_BASE_URL=http://localhost:8000/v1
# ฐาน URL ของ API ฝั่งลูกค้า — ทุก tool ที่สเปคประกาศ impl:"http" ยิงไปที่นี่
# สเปคเขียน url เป็น "{API_BASE}/verify" ค่านี้คือส่วนที่มาแทน {API_BASE}
AAX6_API_BASE=http://127.0.0.1:3001

# ══ โหมดการทำงาน ════════════════════════════════════════════════════
AAX6_DEMO_MODE=live                    # live | replay          (ปริยาย live)
AAX6_DEMO_AGENT=qwen                   # qwen | gemini          (ปริยาย qwen)
# AAX6_FLOW_MODEL=                     # ไม่ตั้ง = ใช้ตัวที่ vLLM เสิร์ฟอยู่
# หลายโมเดลให้เลือกในหน้าเว็บ: คั่นด้วยจุลภาค (ทับ AAX6_VLLM_BASE_URL)
# AAX6_VLLM_BASE_URLS=http://localhost:8000/v1,http://localhost:8001/v1

# ══ พรอมป์ ═════════════════════════════════════════════════════════
AAX6_DEMO_PROMPT=spread_cache          # spread_cache | cache | spread | legacy
# AAX6_FLOW_COMPANY=AEON               # บังคับให้เปิดสายด้วยบริษัทนี้
# AAX6_PROMPT_VERSION=                 # เลือกไฟล์คำสั่งรุ่นอื่น (ปกติเว้นว่าง)

# ══ หน้าเว็บที่ build แล้ว ══════════════════════════════════════════
AAX6_DEMO_STATIC=demo_v2/frontend/dist

# ══ เสียงพูดออก (TTS) — ไม่ตั้ง = /api/tts ใช้ไม่ได้ แต่พิมพ์คุยได้ปกติ ══
GOOGLE_APPLICATION_CREDENTIALS=./adc.json
GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CREDENTIALS_JSON=            # ใส่ JSON ทั้งก้อนแทนไฟล์ก็ได้
AAX6_TTS_CACHE=1
AAX6_TTS_CHUNK_TARGET=30
AAX6_TTS_PREWARM_FILLER=1
# AAX6_TTS_ENDPOINT=                  # ชี้ไปเซิร์ฟเวอร์ TTS อื่น

# ══ เสียงพูดเข้า (STT) — ไม่ตั้ง = หน้าเว็บถอยไปใช้ Web Speech API ══
AAX6_STT_ENGINE=zipformer
AAX6_ZIPFORMER_URL=ws://127.0.0.1:2997
# AAX6_ZIPFORMER_HOTWORDS=            # คำที่อยากให้ถอดถูก คั่นด้วยจุลภาค
# AAX6_ZIPFORMER_BOOST=               # น้ำหนักของ hotwords
AAX6_VAD_THRESHOLD=0.4
AAX6_VAD_MIN_SPEECH_MS=100
AAX6_VAD_SILENCE_HANG_MS=250

# ══ ไม่ค่อยได้ใช้ ═══════════════════════════════════════════════════
# AAX6_DEMO_SELF_URL=http://127.0.0.1:4100   # ให้ session_init เรียกกลับมาที่ตัวเอง
# AAX6_FLOW_FILLER=0                          # 1 = เปิดประโยคคั่นระหว่างรอ tool
# AAX6_DEMO_CASE_ID=                          # เคสที่ใช้ในโหมด replay
