# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node / frontend build
node_modules/
demo/frontend/dist/

# Env — the operator provides their own (see README "Configuration")
.env
.env.*

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp

# NOTE: checkpoints/ is intentionally NOT ignored — the adapters this deliverable
# serves ship with the repo via git-LFS (see .gitattributes). Add a checkpoint here
# only when the demo is meant to serve it: each one is ~240 MB against the LFS quota
# and cannot be taken back out cheaply. Everything else stays on the training pod.
checkpoints/sft_v10/

# Saved demo conversations are runtime artifacts: keep the folder, ignore contents.
#data/demo-saved-trajectory/*
!data/demo-saved-trajectory/.gitkeep

# Internal hand-off doc (background for the maintaining agent) — not shipped to the customer.
HANDOFF.md
